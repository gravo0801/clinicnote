          style={{ padding: '8px 14px', background: url.trim() ? '#0F6E56' : '#d1d5db', color: '#fff', border: 'none', borderRadius: 7, fontSize: 12, fontWeight: 700, cursor: url.trim() ? 'pointer' : 'not-allowed', flexShrink: 0 }}>
