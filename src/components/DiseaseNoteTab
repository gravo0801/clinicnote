import { useState, useEffect, useMemo, useRef } from 'react'
import {
  collection, onSnapshot, addDoc, deleteDoc, updateDoc,
  doc, serverTimestamp, query, orderBy
} from 'firebase/firestore'
import { ref, uploadBytesResumable, getDownloadURL, deleteObject } from 'firebase/storage'
import { db, storage } from '../firebase'
import { Sheet, Spinner, useIsMobile } from './ui'

// ── 파일 타입 판별 ─────────────────────────────────────────
function getFileType(name = '', mime = '') {
  const ext = name.split('.').pop().toLowerCase()
  if (['jpg','jpeg','png','gif','webp','svg'].includes(ext) || mime.startsWith('image/')) return 'image'
  if (ext === 'pdf' || mime === 'application/pdf') return 'pdf'
  if (['ppt','pptx'].includes(ext) || mime.includes('presentationml') || mime.includes('powerpoint')) return 'pptx'
  if (['doc','docx'].includes(ext) || mime.includes('wordprocessingml') || mime.includes('msword')) return 'docx'
  if (['xls','xlsx'].includes(ext) || mime.includes('spreadsheetml')) return 'xlsx'
  if (['mp4','mov','avi','webm'].includes(ext) || mime.startsWith('video/')) return 'video'
  if (['mp3','wav','m4a','ogg'].includes(ext) || mime.startsWith('audio/')) return 'audio'
  return 'file'
}

const TYPE_META = {
  image: { icon:'🖼', label:'이미지', color:'#0891b2' },
  pdf:   { icon:'📄', label:'PDF',   color:'#dc2626' },
  pptx:  { icon:'📊', label:'PPTX',  color:'#d97706' },
  docx:  { icon:'📝', label:'DOCX',  color:'#2563eb' },
  xlsx:  { icon:'📈', label:'XLSX',  color:'#059669' },
  video: { icon:'🎬', label:'동영상', color:'#7c3aed' },
  audio: { icon:'🎵', label:'오디오', color:'#0F6E56' },
  file:  { icon:'📎', label:'파일',  color:'#6b7280' },
}

// ── Google Docs Viewer URL ────────────────────────────────
const googleViewerUrl = (url) =>
  `https://docs.google.com/viewer?url=${encodeURIComponent(url)}&embedded=true`

// ── 파일 미리보기 컴포넌트 ─────────────────────────────────
function FilePreview({ file }) {
  const [show, setShow] = useState(false)
  const t = getFileType(file.name, file.mime || '')
  const meta = TYPE_META[t] || TYPE_META.file

  return (
    <div style={{ marginBottom: 8 }}>
      {/* 파일 헤더 행 */}
      <div style={{ display:'flex', alignItems:'center', gap:8, padding:'7px 10px', background:'#f8f6f2', borderRadius:8, border:'1px solid #f0ede8' }}>
        <span style={{ fontSize:16 }}>{meta.icon}</span>
        <span style={{ fontSize:12, fontWeight:600, color:'#1a1a1a', flex:1, overflow:'hidden', textOverflow:'ellipsis', whiteSpace:'nowrap' }}>{file.name}</span>
        <span style={{ fontSize:10, color:meta.color, background:`${meta.color}18`, borderRadius:4, padding:'1px 6px', fontWeight:700 }}>{meta.label}</span>
        <div style={{ display:'flex', gap:5, flexShrink:0 }}>
          {['image','pdf','pptx','docx','video','audio'].includes(t) && (
            <button onClick={() => setShow(p => !p)}
              style={{ fontSize:11, color:show?'#0F6E56':'#6b7280', background:show?'#f0faf5':'#fff', border:'1px solid #e5e7eb', borderRadius:5, padding:'2px 8px', cursor:'pointer', fontWeight:600 }}>
              {show ? '접기' : '미리보기'}
            </button>
          )}
          <a href={file.url} target="_blank" rel="noopener noreferrer" download={file.name}
            style={{ fontSize:11, color:'#2563eb', background:'#eff6ff', border:'1px solid #bfdbfe', borderRadius:5, padding:'2px 8px', textDecoration:'none', fontWeight:600 }}>
            다운↗
          </a>
        </div>
      </div>

      {/* 미리보기 영역 */}
      {show && (
        <div style={{ border:'1px solid #e5e7eb', borderTop:'none', borderRadius:'0 0 8px 8px', overflow:'hidden', background:'#fff' }}>
          {t === 'image' && (
            <img src={file.url} alt={file.name}
              style={{ width:'100%', maxHeight:480, objectFit:'contain', display:'block', background:'#f0f0f0' }} />
          )}
          {t === 'video' && (
            <video controls style={{ width:'100%', maxHeight:360, background:'#000' }}>
              <source src={file.url} /><p style={{ padding:16, color:'#6b7280' }}>동영상을 지원하지 않습니다.</p>
            </video>
          )}
          {t === 'audio' && (
            <div style={{ padding:16 }}>
              <audio controls style={{ width:'100%' }}><source src={file.url} /></audio>
            </div>
          )}
          {(t === 'pdf' || t === 'pptx' || t === 'docx' || t === 'xlsx') && (
            <div style={{ position:'relative' }}>
              <iframe
                src={t === 'pdf' ? file.url : googleViewerUrl(file.url)}
                style={{ width:'100%', height:520, border:'none', display:'block' }}
                title={file.name}
                allowFullScreen
              />
              {(t === 'pptx' || t === 'docx') && (
                <div style={{ padding:'6px 12px', background:'#fffbeb', fontSize:11, color:'#92400e', borderTop:'1px solid #fde68a' }}>
                  💡 Google Docs 뷰어로 표시됩니다. 로딩이 느리면 다운로드 후 열어보세요.
                </div>
              )}
            </div>
          )}
        </div>
      )}
    </div>
  )
}

// ── 업로드 진행 바 ─────────────────────────────────────────
function UploadProgress({ progress, name }) {
  return (
    <div style={{ padding:'8px 12px', background:'#eff6ff', borderRadius:8, marginBottom:6 }}>
      <div style={{ display:'flex', justifyContent:'space-between', marginBottom:4 }}>
        <span style={{ fontSize:12, color:'#1d4ed8', fontWeight:600 }}>📤 {name}</span>
        <span style={{ fontSize:11, color:'#2563eb' }}>{progress}%</span>
      </div>
      <div style={{ background:'#bfdbfe', borderRadius:4, height:5 }}>
        <div style={{ background:'#2563eb', borderRadius:4, height:5, width:`${progress}%`, transition:'width 0.3s' }} />
      </div>
    </div>
  )
}

// ── 노트 카드 ──────────────────────────────────────────────
function NoteCard({ note, onEdit, onDelete }) {
  const [open, setOpen] = useState(false)
  const dateStr = note.createdAt?.toDate
    ? note.createdAt.toDate().toLocaleDateString('ko-KR', { year:'numeric', month:'long', day:'numeric', weekday:'short' })
    : (note.dateLabel || '')

  const fileCount = (note.files || []).length
  const hasText = !!(note.content?.trim())
  const tags = note.tags || []

  return (
    <div style={{ border:'1px solid #e5e7eb', borderRadius:12, overflow:'hidden', marginBottom:10, boxShadow: open ? '0 2px 12px rgba(0,0,0,0.06)' : 'none', transition:'box-shadow 0.2s' }}>
      {/* 카드 헤더 (항상 표시) */}
      <div onClick={() => setOpen(p => !p)}
        style={{ display:'flex', alignItems:'flex-start', gap:12, padding:'13px 16px', background: open ? '#f0faf5' : '#fff', cursor:'pointer', userSelect:'none' }}>
        <div style={{ width:28, height:28, borderRadius:8, background:'#0F6E56', display:'flex', alignItems:'center', justifyContent:'center', fontSize:14, flexShrink:0, marginTop:1 }}>📋</div>
        <div style={{ flex:1, minWidth:0 }}>
          <div style={{ fontSize:14, fontWeight:700, color:'#1a1a1a', marginBottom:3, overflow:'hidden', textOverflow:'ellipsis', whiteSpace:'nowrap' }}>
            {note.title || '제목 없음'}
          </div>
          <div style={{ display:'flex', gap:8, flexWrap:'wrap', alignItems:'center' }}>
            <span style={{ fontSize:11, color:'#9ca3af' }}>{dateStr}</span>
            {fileCount > 0 && <span style={{ fontSize:11, color:'#6b7280', background:'#f3f4f6', borderRadius:4, padding:'1px 6px' }}>📎 {fileCount}개</span>}
            {hasText && <span style={{ fontSize:11, color:'#6b7280', background:'#f3f4f6', borderRadius:4, padding:'1px 6px' }}>📝 텍스트</span>}
            {tags.map(t => <span key={t} style={{ fontSize:10, color:'#0F6E56', background:'#f0faf5', border:'1px solid #d1fae5', borderRadius:10, padding:'1px 7px', fontWeight:600 }}>{t}</span>)}
          </div>
        </div>
        <div style={{ display:'flex', gap:6, flexShrink:0 }}>
          <button onClick={e => { e.stopPropagation(); onEdit(note) }}
            style={{ fontSize:11, color:'#6b7280', background:'none', border:'1px solid #e5e7eb', borderRadius:5, padding:'3px 9px', cursor:'pointer' }}>수정</button>
          <button onClick={e => { e.stopPropagation(); onDelete(note.id) }}
            style={{ fontSize:11, color:'#ef4444', background:'none', border:'1px solid #fca5a5', borderRadius:5, padding:'3px 9px', cursor:'pointer' }}>삭제</button>
          <span style={{ fontSize:11, color:'#9ca3af', padding:'3px 2px', display:'flex', alignItems:'center', transition:'transform 0.2s', transform: open ? 'rotate(180deg)' : 'none' }}>▼</span>
        </div>
      </div>

      {/* 카드 내용 (접기/펼치기) */}
      {open && (
        <div style={{ padding:'16px', borderTop:'1px solid #f0ede8', background:'#fff' }}>
          {/* 카테고리/카테고리 배지 */}
          {note.category && (
            <div style={{ marginBottom:10 }}>
              <span style={{ fontSize:11, background:'#e6f4ef', color:'#0F6E56', borderRadius:20, padding:'3px 10px', fontWeight:600 }}>{note.category}</span>
            </div>
          )}

          {/* 본문 텍스트 */}
          {hasText && (
            <div style={{ fontSize:13, color:'#1a1a1a', lineHeight:1.8, whiteSpace:'pre-wrap', marginBottom: fileCount > 0 ? 14 : 0, background:'#fafaf9', borderRadius:8, padding:'12px 14px', border:'1px solid #f0ede8' }}>
              {note.content}
            </div>
          )}

          {/* 첨부 파일 목록 */}
          {fileCount > 0 && (
            <div>
              <div style={{ fontSize:11, color:'#9ca3af', fontWeight:600, marginBottom:8 }}>첨부 파일 ({fileCount})</div>
              {note.files.map((f, i) => <FilePreview key={i} file={f} />)}
            </div>
          )}
        </div>
      )}
    </div>
  )
}

// ── 노트 폼 (추가/수정) ────────────────────────────────────
const CATEGORIES = ['전체','내과','호흡기','소화기','순환기','내분비','근골격','신경','감염','소아','피부','이비인후','기타']

function NoteForm({ initial, onSave, onClose }) {
  const [title, setTitle]     = useState(initial?.title || '')
  const [category, setCat]    = useState(initial?.category || '내과')
  const [tags, setTagsStr]    = useState((initial?.tags || []).join(', '))
  const [content, setContent] = useState(initial?.content || '')
  const [files, setFiles]     = useState(initial?.files || [])   // {name, url, mime, size}
  const [uploads, setUploads] = useState([])  // {name, progress}
  const [saving, setSaving]   = useState(false)
  const fileInputRef = useRef(null)

  const handleFiles = async (e) => {
    const selected = Array.from(e.target.files)
    for (const file of selected) {
      const path = `diseaseNotes/${Date.now()}_${file.name}`
      const storageRef = ref(storage, path)
      const task = uploadBytesResumable(storageRef, file)

      setUploads(p => [...p, { name: file.name, progress: 0, path }])

      await new Promise((resolve) => {
        task.on('state_changed',
          snap => {
            const pct = Math.round(snap.bytesTransferred / snap.totalBytes * 100)
            setUploads(p => p.map(u => u.path === path ? { ...u, progress: pct } : u))
          },
          (err) => { console.error(err); resolve() },
          async () => {
            const url = await getDownloadURL(task.snapshot.ref)
            const newFile = { name: file.name, url, mime: file.type, size: file.size, path }
            setFiles(p => [...p, newFile])
            setUploads(p => p.filter(u => u.path !== path))
            resolve()
          }
        )
      })
    }
    e.target.value = ''
  }

  const removeFile = async (idx) => {
    const f = files[idx]
    if (f.path) {
      try { await deleteObject(ref(storage, f.path)) } catch (_) {}
    }
    setFiles(p => p.filter((_, i) => i !== idx))
  }

  const handleSave = async () => {
    if (!title.trim()) return
    setSaving(true)
    const tagArr = tags.split(',').map(t => t.trim()).filter(Boolean)
    const payload = { title: title.trim(), category, tags: tagArr, content, files }
    await onSave(payload)
    setSaving(false)
  }

  const iStyle = { width:'100%', padding:'9px 11px', borderRadius:8, border:'1px solid #e5e7eb', fontSize:13, outline:'none', boxSizing:'border-box', fontFamily:'inherit', background:'#fff', color:'#1a1a1a' }
  const lStyle = { display:'block', fontSize:11, color:'#6b7280', marginBottom:4, fontWeight:600 }

  return (
    <div style={{ paddingBottom:20 }}>
      {/* 제목 */}
      <div style={{ marginBottom:12 }}>
        <label style={lStyle}>제목 *</label>
        <input value={title} onChange={e => setTitle(e.target.value)} placeholder="예: 급성 기관지염 치료 가이드라인" style={iStyle} autoFocus />
      </div>
      {/* 카테고리 */}
      <div style={{ marginBottom:12 }}>
        <label style={lStyle}>카테고리</label>
        <div style={{ display:'flex', flexWrap:'wrap', gap:5 }}>
          {CATEGORIES.filter(c => c !== '전체').map(c => (
            <button key={c} onClick={() => setCat(c)}
              style={{ padding:'4px 11px', borderRadius:20, border: category===c?'none':'1px solid #e5e7eb', background: category===c?'#0F6E56':'#fff', color: category===c?'#fff':'#6b7280', fontSize:12, cursor:'pointer', fontWeight: category===c?700:400 }}>
              {c}
            </button>
          ))}
        </div>
      </div>
      {/* 태그 */}
      <div style={{ marginBottom:12 }}>
        <label style={lStyle}>태그 (쉼표로 구분)</label>
        <input value={tags} onChange={e => setTagsStr(e.target.value)} placeholder="예: 항생제, 소아, 처방팁" style={iStyle} />
      </div>
      {/* 본문 텍스트 */}
      <div style={{ marginBottom:14 }}>
        <label style={lStyle}>내용 (텍스트 붙여넣기 가능)</label>
        <textarea value={content} onChange={e => setContent(e.target.value)}
          placeholder="교재 내용, 가이드라인 요약, 공부 메모 등을 자유롭게 붙여넣거나 작성하세요..."
          style={{ ...iStyle, resize:'vertical', minHeight:160, lineHeight:1.75 }} />
      </div>

      {/* 파일 업로드 */}
      <div style={{ marginBottom:16 }}>
        <label style={lStyle}>파일 첨부 (이미지·PDF·PPTX·DOCX·동영상 등)</label>
        <label style={{ display:'inline-flex', alignItems:'center', gap:7, padding:'8px 14px', background:'#f0faf5', color:'#0F6E56', border:'1px dashed #6ee7b7', borderRadius:8, fontSize:13, cursor:'pointer', fontWeight:600 }}>
          📎 파일 선택
          <input ref={fileInputRef} type="file" multiple accept="image/*,.pdf,.ppt,.pptx,.doc,.docx,.xls,.xlsx,.mp4,.mov,.mp3,.wav"
            onChange={handleFiles} style={{ display:'none' }} />
        </label>
        <span style={{ fontSize:11, color:'#9ca3af', marginLeft:10 }}>이미지·PDF·PPTX·DOCX·동영상 등 제한 없음</span>

        {/* 업로드 진행 */}
        {uploads.length > 0 && (
          <div style={{ marginTop:10 }}>
            {uploads.map(u => <UploadProgress key={u.path} progress={u.progress} name={u.name} />)}
          </div>
        )}

        {/* 첨부된 파일 목록 */}
        {files.length > 0 && (
          <div style={{ marginTop:10, display:'flex', flexDirection:'column', gap:5 }}>
            {files.map((f, i) => {
              const t = getFileType(f.name, f.mime || '')
              const meta = TYPE_META[t] || TYPE_META.file
              return (
                <div key={i} style={{ display:'flex', alignItems:'center', gap:8, padding:'6px 10px', background:'#f8f6f2', borderRadius:7, border:'1px solid #f0ede8' }}>
                  <span>{meta.icon}</span>
                  <span style={{ fontSize:12, flex:1, overflow:'hidden', textOverflow:'ellipsis', whiteSpace:'nowrap' }}>{f.name}</span>
                  <span style={{ fontSize:10, color:meta.color, fontWeight:600 }}>{meta.label}</span>
                  {f.size && <span style={{ fontSize:10, color:'#9ca3af' }}>{(f.size/1024/1024).toFixed(1)}MB</span>}
                  <button onClick={() => removeFile(i)} style={{ background:'none', border:'none', color:'#ef4444', cursor:'pointer', fontSize:14, lineHeight:1, padding:'0 2px' }}>×</button>
                </div>
              )
            })}
          </div>
        )}
      </div>

      {/* 저장 버튼 */}
      <button onClick={handleSave} disabled={!title.trim() || saving || uploads.length > 0}
        style={{ width:'100%', padding:'12px', background: !title.trim()||saving||uploads.length>0 ? '#d1d5db' : '#0F6E56', color:'#fff', border:'none', borderRadius:9, fontSize:14, fontWeight:700, cursor: !title.trim()||saving||uploads.length>0 ? 'not-allowed' : 'pointer' }}>
        {saving ? '저장 중...' : uploads.length > 0 ? '파일 업로드 중...' : (initial ? '수정 완료' : '노트 저장')}
      </button>
    </div>
  )
}

// ── 메인 컴포넌트 ──────────────────────────────────────────
export default function DiseaseNoteTab() {
  const isMobile = useIsMobile()
  const [notes, setNotes]       = useState([])
  const [loading, setLoading]   = useState(true)
  const [search, setSearch]     = useState('')
  const [catFilter, setCatFilter] = useState('전체')
  const [showForm, setShowForm] = useState(false)
  const [editTarget, setEditTarget] = useState(null)

  useEffect(() => {
    const q = query(collection(db, 'diseaseNotes2'), orderBy('createdAt', 'desc'))
    return onSnapshot(q, snap => {
      setNotes(snap.docs.map(d => ({ id: d.id, ...d.data() })))
      setLoading(false)
    })
  }, [])

  const saveNote = async (payload) => {
    if (editTarget) {
      await updateDoc(doc(db, 'diseaseNotes2', editTarget.id), { ...payload, updatedAt: serverTimestamp() })
    } else {
      await addDoc(collection(db, 'diseaseNotes2'), { ...payload, createdAt: serverTimestamp() })
    }
    setShowForm(false); setEditTarget(null)
  }

  const deleteNote = async (id) => {
    if (!window.confirm('노트를 삭제하시겠습니까?')) return
    const note = notes.find(n => n.id === id)
    // Storage 파일도 삭제
    for (const f of (note?.files || [])) {
      if (f.path) try { await deleteObject(ref(storage, f.path)) } catch (_) {}
    }
    await deleteDoc(doc(db, 'diseaseNotes2', id))
  }

  // 날짜별 그룹화
  const filtered = useMemo(() => notes.filter(n => {
    const catOk = catFilter === '전체' || n.category === catFilter
    const q = search.toLowerCase()
    const sOk = !q || [n.title, n.content, n.category, ...(n.tags||[]), ...(n.files||[]).map(f=>f.name)].some(t => t?.toLowerCase().includes(q))
    return catOk && sOk
  }), [notes, catFilter, search])

  // 날짜별 그룹
  const grouped = useMemo(() => {
    const groups = {}
    filtered.forEach(n => {
      const d = n.createdAt?.toDate ? n.createdAt.toDate() : new Date()
      const key = d.toLocaleDateString('ko-KR', { year:'numeric', month:'long', day:'numeric', weekday:'short' })
      if (!groups[key]) groups[key] = []
      groups[key].push(n)
    })
    return groups
  }, [filtered])

  const formJsx = showForm || editTarget ? (
    <Sheet title={editTarget ? '노트 수정' : '새 질환 노트'} onClose={() => { setShowForm(false); setEditTarget(null) }}>
      <NoteForm
        initial={editTarget}
        onSave={saveNote}
        onClose={() => { setShowForm(false); setEditTarget(null) }}
      />
    </Sheet>
  ) : null

  if (loading) return <Spinner />

  // ── 카테고리 탭 ─────────────────────────────────────────
  const CatTabs = () => (
    <div style={{ display:'flex', gap:5, overflowX:'auto', paddingBottom:4, marginBottom:12, scrollbarWidth:'none' }}>
      {CATEGORIES.map(c => {
        const cnt = c === '전체' ? notes.length : notes.filter(n => n.category === c).length
        return (
          <button key={c} onClick={() => setCatFilter(c)}
            style={{ padding:'5px 12px', borderRadius:20, border: catFilter===c?'none':'1px solid #e5e7eb', background: catFilter===c?'#0F6E56':'#fff', color: catFilter===c?'#fff':'#6b7280', fontSize:12, cursor:'pointer', whiteSpace:'nowrap', flexShrink:0, fontWeight: catFilter===c?700:400 }}>
            {c} {cnt > 0 && <span style={{ opacity:0.75 }}>({cnt})</span>}
          </button>
        )
      })}
    </div>
  )

  // ── 모바일 레이아웃 ──────────────────────────────────────
  if (isMobile) {
    return (
      <div style={{ padding:'12px 16px', paddingBottom:80 }}>
        {/* 검색 */}
        <div style={{ position:'relative', marginBottom:12 }}>
          <span style={{ position:'absolute', left:11, top:'50%', transform:'translateY(-50%)', fontSize:14, color:'#9ca3af' }}>🔍</span>
          <input value={search} onChange={e => setSearch(e.target.value)} placeholder="제목·내용·태그·파일명 검색..."
            style={{ width:'100%', padding:'9px 12px 9px 34px', borderRadius:10, border:'1px solid #e5e7eb', fontSize:14, outline:'none', boxSizing:'border-box', fontFamily:'inherit' }} />
        </div>
        <CatTabs />
        <div style={{ display:'flex', justifyContent:'space-between', alignItems:'center', marginBottom:14 }}>
          <span style={{ fontSize:12, color:'#9ca3af' }}>{filtered.length}개 노트</span>
          <button onClick={() => setShowForm(true)}
            style={{ background:'#0F6E56', color:'#fff', border:'none', borderRadius:20, padding:'7px 18px', fontSize:13, fontWeight:700, cursor:'pointer' }}>
            + 새 노트
          </button>
        </div>
        {filtered.length === 0
          ? <EmptyState onAdd={() => setShowForm(true)} search={search} />
          : Object.entries(grouped).map(([date, group]) => (
            <DateGroup key={date} date={date} notes={group} onEdit={n => setEditTarget(n)} onDelete={deleteNote} />
          ))
        }
        {formJsx}
      </div>
    )
  }

  // ── 데스크탑 레이아웃 ─────────────────────────────────────
  return (
    <div style={{ display:'flex', height:'100vh', overflow:'hidden' }}>
      {/* 좌측 사이드바 */}
      <div style={{ width:260, background:'#fff', borderRight:'1px solid #ece9e3', display:'flex', flexDirection:'column', flexShrink:0 }}>
        <div style={{ padding:'16px 14px 12px', borderBottom:'1px solid #f0ede8' }}>
          <div style={{ position:'relative' }}>
            <span style={{ position:'absolute', left:10, top:'50%', transform:'translateY(-50%)', fontSize:12, color:'#9ca3af' }}>🔍</span>
            <input value={search} onChange={e => setSearch(e.target.value)} placeholder="노트 검색..."
              style={{ width:'100%', padding:'8px 10px 8px 28px', borderRadius:8, border:'1px solid #e5e7eb', fontSize:12, outline:'none', boxSizing:'border-box', fontFamily:'inherit' }} />
          </div>
        </div>

        {/* 카테고리 필터 */}
        <div style={{ flex:1, overflowY:'auto', padding:'10px 10px 0' }}>
          <div style={{ fontSize:11, color:'#9ca3af', fontWeight:700, marginBottom:8, paddingLeft:4 }}>카테고리</div>
          {CATEGORIES.map(c => {
            const cnt = c === '전체' ? notes.length : notes.filter(n => n.category === c).length
            return (
              <button key={c} onClick={() => setCatFilter(c)}
                style={{ width:'100%', display:'flex', justifyContent:'space-between', alignItems:'center', padding:'7px 10px', borderRadius:8, border:'none', background: catFilter===c?'#f0faf5':'transparent', color: catFilter===c?'#0F6E56':'#374151', fontSize:13, fontWeight: catFilter===c?700:400, cursor:'pointer', marginBottom:2, textAlign:'left' }}>
                <span>{c}</span>
                <span style={{ fontSize:11, background: catFilter===c?'#dcfce7':'#f3f4f6', color: catFilter===c?'#0F6E56':'#9ca3af', borderRadius:10, padding:'1px 7px' }}>{cnt}</span>
              </button>
            )
          })}
        </div>

        <div style={{ padding:'12px', borderTop:'1px solid #f0ede8' }}>
          <button onClick={() => setShowForm(true)}
            style={{ width:'100%', padding:'10px', background:'#0F6E56', color:'#fff', border:'none', borderRadius:10, fontSize:13, fontWeight:700, cursor:'pointer' }}>
            + 새 질환 노트
          </button>
        </div>
      </div>

      {/* 메인 콘텐츠 */}
      <div style={{ flex:1, overflowY:'auto', background:'#f5f3ef', padding:'24px 28px' }}>
        {/* 헤더 */}
        <div style={{ display:'flex', justifyContent:'space-between', alignItems:'center', marginBottom:20 }}>
          <div>
            <h2 style={{ margin:0, fontSize:18, fontWeight:700 }}>
              {catFilter === '전체' ? '전체 노트' : catFilter}
            </h2>
            <div style={{ fontSize:12, color:'#9ca3af', marginTop:2 }}>{filtered.length}개 · {Object.keys(grouped).length}일</div>
          </div>
          <button onClick={() => setShowForm(true)}
            style={{ background:'#0F6E56', color:'#fff', border:'none', borderRadius:20, padding:'8px 20px', fontSize:13, fontWeight:700, cursor:'pointer' }}>
            + 새 노트
          </button>
        </div>

        {filtered.length === 0
          ? <EmptyState onAdd={() => setShowForm(true)} search={search} />
          : Object.entries(grouped).map(([date, group]) => (
            <DateGroup key={date} date={date} notes={group} onEdit={n => setEditTarget(n)} onDelete={deleteNote} />
          ))
        }
      </div>
      {formJsx}
    </div>
  )
}

// ── 날짜 그룹 ─────────────────────────────────────────────
function DateGroup({ date, notes, onEdit, onDelete }) {
  const [open, setOpen] = useState(true)
  return (
    <div style={{ marginBottom:16 }}>
      <button onClick={() => setOpen(p => !p)}
        style={{ display:'flex', alignItems:'center', gap:8, background:'none', border:'none', cursor:'pointer', padding:'4px 0', marginBottom:8, width:'100%', textAlign:'left' }}>
        <span style={{ fontSize:11, fontWeight:700, color:'#9ca3af', letterSpacing:'0.5px' }}>{date}</span>
        <span style={{ flex:1, height:1, background:'#e5e7eb' }} />
        <span style={{ fontSize:11, color:'#9ca3af', background:'#f3f4f6', borderRadius:10, padding:'1px 7px' }}>{notes.length}개</span>
        <span style={{ fontSize:10, color:'#9ca3af', display:'inline-block', transform: open?'rotate(180deg)':'none', transition:'transform 0.2s' }}>▼</span>
      </button>
      {open && notes.map(n => (
        <NoteCard key={n.id} note={n} onEdit={onEdit} onDelete={onDelete} />
      ))}
    </div>
  )
}

// ── 빈 상태 ───────────────────────────────────────────────
function EmptyState({ onAdd, search }) {
  return (
    <div style={{ textAlign:'center', padding:'64px 20px', color:'#9ca3af' }}>
      <div style={{ fontSize:48, marginBottom:14 }}>📚</div>
      <div style={{ fontSize:16, fontWeight:700, color:'#374151', marginBottom:8 }}>
        {search ? `"${search}" 검색 결과 없음` : '질환 노트가 없습니다'}
      </div>
      <div style={{ fontSize:13, marginBottom:20, lineHeight:1.6 }}>
        {search ? '다른 키워드로 검색해보세요.' : '교재·가이드라인·논문 내용을 정리하고\nPDF·PPTX·이미지 파일을 첨부해 보세요.'}
      </div>
      {!search && (
        <button onClick={onAdd}
          style={{ background:'#0F6E56', color:'#fff', border:'none', borderRadius:20, padding:'10px 24px', fontSize:14, fontWeight:700, cursor:'pointer' }}>
          첫 노트 작성하기
        </button>
      )}
    </div>
  )
}
