        <label style={{ ...lStyle, marginBottom: 8, fontSize: 12, color: '#374151' }}>
          파일 링크 첨부 (PDF / PPTX / Google Drive / Slides)
        </label>
        <LinkInput links={links} onChange={setLinks} />
      </div>
      <button onClick={handleSave} disabled={!title.trim() || saving || imgLoading}
        style={{ width: '100%', padding: '12px', background: !title.trim() || saving || imgLoading ? '#d1d5db' : '#0F6E56', color: '#fff', border: 'none', borderRadius: 9, fontSize: 14, fontWeight: 700, cursor: !title.trim() || saving || imgLoading ? 'not-allowed' : 'pointer' }}>
